# Copy to .env and fill in before running docker-compose.yml (the VPS/
# production topology — it reads shared Postgres/Redis credentials from
# here, with NO defaults, since there's no safe default for credentials to
# infrastructure shared with other apps on the box).
#
# local-docker-compose.yml needs none of this — every value there is
# hardcoded for a self-contained local stack. This file only matters for
# docker-compose.yml.

# Shared Postgres instance on backend-net. Use a DEDICATED user/db for this
# app, not one shared with other services on the box.
FEED_DB_USER=
FEED_DB_PASSWORD=
FEED_DB_NAME=feedapp

# Shared Redis instance on backend-net. Give this app its OWN db index (the
# trailing /N) so its keys can't collide with another app's on the same
# instance.
FEED_REDIS_URL=redis://redis:6379/1

# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

LOG_LEVEL=info

# The hostname Traefik routes to this stack.
DOMAIN=feed.sanattudu.tech

# Copy to .env and adjust for your environment. docker-compose.yml falls
# back to the defaults shown here if .env is absent, EXCEPT JWT_SECRET,
# which is required (compose refuses to start the api service without it —
# there's no safe default for a token-signing secret).

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=feedapp

LOG_LEVEL=info

# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Admin tool logins (pgAdmin / RedisInsight — see "Admin/debug tools" below).
# Change these before exposing either tool beyond localhost.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Host port mappings — change these if they collide with something else on
# your machine. Containers still talk to each other on their default ports
# regardless of what you map here.
NGINX_PORT=8080
# WEB_PORT is unused while web's `ports:` mapping is commented out in
# docker-compose.yml (nginx is the only way in, by current design).
WEB_PORT=3000
PGADMIN_PORT=5050
REDISINSIGHT_PORT=5540

# These three only take effect via docker-compose.override.yml (local
# debugging — psql/redis-cli/a Kafka client). There's no API_PORT: the api
# service has no direct host port, by design — it's reachable only through
# nginx at /api.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
